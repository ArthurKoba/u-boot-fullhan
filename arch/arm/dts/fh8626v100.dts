// SPDX-License-Identifier: GPL-2.0+
/dts-v1/;

#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Fullhan FH8626V100 reference platform";
	compatible = "fullhan,fh8626v100";

	#address-cells = <1>;
	#size-cells = <1>;

	aliases {
		serial0 = &uart0;
		ethernet0 = &gmac;
		spi0 = &spi0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@a0000000 {
		device_type = "memory";
		reg = <0xa0000000 0x04000000>;
	};

	timer_clk: clock-1000000 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <1000000>;
	};

	spi_clk: clock-100000000 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <100000000>;
	};

	gpio0: gpio@f0300000 {
		compatible = "snps,dw-apb-gpio";
		reg = <0xf0300000 0x4000>;
		#address-cells = <1>;
		#size-cells = <0>;

		gpio0_porta: gpio-controller@0 {
			compatible = "snps,dw-apb-gpio-port";
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <32>;
			reg = <0>;
			bank-name = "GPIO0";
		};
	};

	gpio1: gpio@f4000000 {
		compatible = "snps,dw-apb-gpio";
		reg = <0xf4000000 0x4000>;
		#address-cells = <1>;
		#size-cells = <0>;

		gpio1_porta: gpio-controller@0 {
			compatible = "snps,dw-apb-gpio-port";
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <32>;
			reg = <0>;
			bank-name = "GPIO1";
		};
	};

	gmac: ethernet@e0600000 {
		compatible = "fullhan,fh8626v100-dwmac";
		reg = <0xe0600000 0x4000>;
		phy-mode = "rmii";
		max-speed = <100>;
		snps,clk-csr = <4>;
		snps,reset-gpio = <&gpio0_porta 11 GPIO_ACTIVE_LOW>;
		snps,reset-active-low;
		snps,reset-delays-us = <0 15000 200000>;
		status = "okay";
	};

	spi0: spi@f0e00000 {
		compatible = "fullhan,fh8626v100-spi";
		reg = <0xf0e00000 0x4000>;
		clocks = <&spi_clk>;
		spi-max-frequency = <50000000>;
		/* The DW SSI driver drives physical CS levels explicitly. */
		cs-gpios = <&gpio1_porta 22 GPIO_ACTIVE_HIGH>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		flash@0 {
			compatible = "jedec,spi-nor";
			reg = <0>;
			spi-max-frequency = <50000000>;
		};
	};

	uart0: serial@f0700000 {
		compatible = "snps,dw-apb-uart";
		reg = <0xf0700000 0x1000>;
		reg-shift = <2>;
		reg-io-width = <4>;
		clock-frequency = <16666667>;
		current-speed = <115200>;
		status = "okay";
		bootph-all;
	};

	timer0: timer@f0c00000 {
		compatible = "snps,dw-apb-timer";
		reg = <0xf0c00000 0x1000>;
		clocks = <&timer_clk>;
		status = "okay";
	};
};
